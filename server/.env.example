# --- core ---
NODE_ENV=development
PORT=4000
DATABASE_URL="mysql://quotex:quotex@127.0.0.1:3306/quotex"
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- market data ---
# simulated = built-in seeded price engine (no external network needed)
# binance   = live trade stream, automatically degrades to simulated if unreachable
FEED_PROVIDER=simulated
FEED_TICK_MS=250

# Live quotes for forex, stocks, indices and commodities (Twelve Data shaped).
# Without a key these markets are priced by the broker engine and labelled as such.
MARKET_DATA_URL=https://api.twelvedata.com/price
MARKET_DATA_KEY=
MARKET_DATA_POLL_MS=15000

# --- trading ---
SETTLEMENT_INTERVAL_MS=200
MAX_OPEN_TRADES=25

# --- wallet ---
MIN_DEPOSIT_USD=10
MIN_WITHDRAW_USD=20
WITHDRAW_FEE_PCT=1
WITHDRAW_FLAT_FEE_USD=1
DEPOSIT_WINDOW_MINUTES=60
# mock watcher auto-confirms pending deposits — turn OFF for any real deployment
MOCK_CHAIN_WATCHER=true
# keep this low in development so the e2e suite does not wait on it
MOCK_CHAIN_CONFIRM_MS=5000
AUTO_APPROVE_WITHDRAWALS=false

# --- compliance ---
# require verified identity before withdrawing above the threshold (0 = always)
REQUIRE_KYC_FOR_WITHDRAWAL=false
KYC_WITHDRAWAL_THRESHOLD_USD=0

# --- partner programme ---
# share of a referred trader's deposits paid to their referrer
REFERRAL_COMMISSION_PCT=5

# --- password reset ---
RESET_TOKEN_MINUTES=30
# returns the reset token in the API response because no mailer is wired up.
# Set to false and send the link from requestReset() once SMTP is configured.
EXPOSE_RESET_TOKEN=true

# --- seed ---
ADMIN_EMAIL=admin@quotexclone.dev
ADMIN_PASSWORD=Admin123!
