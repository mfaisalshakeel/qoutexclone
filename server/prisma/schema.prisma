// Quotex-style binary options platform — data model
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String
  country          String?
  role             String    @default("USER") // USER | ADMIN
  status           String    @default("ACTIVE") // ACTIVE | SUSPENDED
  // money is stored in integer minor units (cents) to avoid float drift
  demoBalance      Int       @default(1000000) // $10,000.00 demo
  realBalance      Int       @default(0)
  lockedBalance    Int       @default(0) // funds held by pending withdrawals
  totalDeposited   Int       @default(0)
  totalWithdrawn   Int       @default(0)
  activeAccount    String    @default("DEMO") // DEMO | REAL
  referralCode     String    @unique
  referredById     String?
  referralEarnings Int       @default(0)
  kycStatus        String    @default("NOT_SUBMITTED") // NOT_SUBMITTED | PENDING | APPROVED | REJECTED
  kycReviewedAt    DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  trades        Trade[]
  pendingTrades PendingTrade[]

  /// Terminal workspace: chart layout and each pane's market and timeframe.
  /// Follows the trader across devices, unlike their per-browser conveniences.
  terminalLayout Json?
  /// The studies on their chart, with the periods and colours they chose.
  chartStudies   Json?
  /// The marks they have drawn, keyed by market symbol.
  chartDrawings  Json?

  /// When true, this trader never appears on the public leaderboard.
  leaderboardOptOut Boolean              @default(false)
  transactions      Transaction[]
  deposits          Deposit[]
  withdrawals       Withdrawal[]
  addresses         DepositAddress[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]           @relation("AuditActor")
  kycSubmissions    KycSubmission[]
  tournamentEntries TournamentEntry[]
  supportTickets    SupportTicket[]
  supportMessages   SupportMessage[]
  resetTokens       PasswordResetToken[]
  promoRedemptions  PromoRedemption[]
  commissionsEarned ReferralCommission[] @relation("CommissionReferrer")
  commissionsGiven  ReferralCommission[] @relation("CommissionReferred")
  notifications     Notification[]

  @@index([referredById])
}

/// One line in a trader's notification centre. `dedupeKey` is the natural key of
/// whatever happened, so a retried webhook or a second sweeper pass can never
/// tell the same trader the same thing twice.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String // TRADE | DEPOSIT | WITHDRAWAL | TOURNAMENT | SUPPORT | SYSTEM
  title     String
  body      String    @db.Text
  /// Where the notification takes the reader, if anywhere.
  href      String?
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Asset {
  id         String @id @default(cuid())
  symbol     String @unique // EURUSD, BTCUSDT, EURUSD_OTC
  name       String // Euro / US Dollar
  pair       String // display form: EUR/USD
  assetClass String @default("CRYPTO") // CURRENCY | CRYPTO | COMMODITY | STOCK | INDEX
  base       String // EUR
  quote      String // USD
  feedSymbol String // provider symbol when a live feed is enabled

  // broker-priced markets trade around the clock and never close
  isOtc Boolean @default(false)

  payoutPct Int @default(85) // profit % on a winning trade
  minStake  Int @default(100) // $1.00
  maxStake  Int @default(500000) // $5,000.00

  /// Risk limits on *new* positions, in cents. 0 falls back to the runtime
  /// setting, which in turn may be 0 for no limit. These reject a stake; they
  /// never move a price or a payout.
  maxOpenStakePerUser     Int @default(0)
  maxExposurePerDirection Int @default(0)

  /// Expiry durations offered on this market, in seconds. Null uses the
  /// platform list from settings.
  durations Json?

  precision Int     @default(2) // decimals shown and quoted
  pipSize   Float   @default(0.01) // smallest meaningful move for this market
  icon      String? // short label or emoji for the market list

  payoutRules   PayoutRule[]
  pendingTrades PendingTrade[]

  basePrice  Float   @default(100)
  volatility Float   @default(0.0009) // per-minute standard deviation of returns
  enabled    Boolean @default(true)
  sortOrder  Int     @default(0)

  // null means always open, which is how OTC and crypto markets trade
  scheduleId String?

  /// Per-market overrides for the broker price engine (see engine/otc.ts).
  /// Null uses the defaults derived from `volatility`.
  otcConfig Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trades   Trade[]
  schedule TradingSchedule? @relation(fields: [scheduleId], references: [id])

  @@index([assetClass, enabled, sortOrder])
  @@index([isOtc, enabled])
  @@index([scheduleId])
}

model Trade {
  id           String    @id @default(cuid())
  userId       String
  assetId      String
  symbol       String
  accountType  String // DEMO | REAL | TOURNAMENT
  // set when the position is played with tournament chips
  entryId      String?
  tournamentId String?
  direction    String // UP | DOWN
  /// DURATION (a fixed length from purchase) | CLOCK (the next boundary)
  expiryMode   String    @default("DURATION")
  stake        Int
  payoutPct    Int
  entryPrice   Float
  exitPrice    Float?
  durationSec  Int
  openedAt     DateTime  @default(now())
  expiresAt    DateTime
  settledAt    DateTime?
  status       String    @default("OPEN") // OPEN | WON | LOST | REFUNDED
  profit       Int       @default(0) // net result in cents (stake excluded for losses => -stake)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id])

  @@index([userId, status])
  @@index([status, expiresAt])
  /// live exposure per market and side, read on every new position
  @@index([assetId, status, direction])
  /// today's settled positions, for the leaderboard
  @@index([status, settledAt])
}

model Transaction {
  id           String   @id @default(cuid())
  userId       String
  accountType  String // DEMO | REAL
  type         String // DEPOSIT | WITHDRAWAL_HOLD | WITHDRAWAL | WITHDRAWAL_REFUND | TRADE_STAKE | TRADE_PAYOUT | TRADE_REFUND | BONUS | ADJUSTMENT | DEMO_RESET
  amount       Int // signed, in cents
  balanceAfter Int
  refType      String?
  refId        String?
  note         String?  @db.Text
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model DepositAddress {
  id        String   @id @default(cuid())
  userId    String
  currency  String // BTC | ETH | USDT
  network   String // BITCOIN | ERC20 | TRC20
  address   String
  memo      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency, network])
  @@index([address])
}

model Deposit {
  id             String    @id @default(cuid())
  userId         String
  currency       String
  network        String
  address        String
  cryptoAmount   String    @default("0") // decimal string, chain precision
  rate           Float     @default(0) // USD per unit at credit time
  creditedAmount Int       @default(0) // cents credited to the real balance
  txHash         String?
  promoCode      String?
  bonusAmount    Int       @default(0)
  confirmations  Int       @default(0)
  requiredConf   Int       @default(2)
  status         String    @default("AWAITING_PAYMENT") // AWAITING_PAYMENT | CONFIRMING | COMPLETED | REJECTED | EXPIRED
  adminNote      String?   @db.Text
  expiresAt      DateTime
  confirmedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([txHash])
}

model Withdrawal {
  id            String    @id @default(cuid())
  userId        String
  currency      String
  network       String
  address       String
  amount        Int // gross USD cents debited from the balance
  fee           Int       @default(0)
  netAmount     Int // amount - fee, converted to crypto
  rate          Float // USD per unit at request time
  cryptoAmount  String
  status        String    @default("PENDING") // PENDING | APPROVED | PROCESSING | COMPLETED | REJECTED | CANCELLED
  txHash        String?
  adminNote     String?   @db.Text
  processedById String?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  detail     String?  @db.Text
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model KycSubmission {
  id             String    @id @default(cuid())
  userId         String
  fullName       String
  dateOfBirth    String
  country        String
  address        String    @db.Text
  documentType   String // PASSPORT | ID_CARD | DRIVING_LICENCE
  documentNumber String
  documentRef    String? // reference to the stored file in your document store
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED
  note           String?   @db.Text
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
}

model PromoCode {
  id             String    @id @default(cuid())
  code           String    @unique
  kind           String    @default("DEPOSIT_BONUS_PCT") // DEPOSIT_BONUS_PCT | FIXED_CREDIT
  value          Int // percent for DEPOSIT_BONUS_PCT, cents for FIXED_CREDIT
  minDeposit     Int       @default(0)
  maxBonus       Int       @default(0) // 0 = uncapped
  maxRedemptions Int       @default(0) // 0 = unlimited
  redemptions    Int       @default(0)
  expiresAt      DateTime?
  enabled        Boolean   @default(true)
  createdAt      DateTime  @default(now())

  uses PromoRedemption[]
}

model PromoRedemption {
  id          String   @id @default(cuid())
  promoCodeId String
  userId      String
  depositId   String?
  amount      Int // bonus credited, in cents
  createdAt   DateTime @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, userId])
  @@index([userId])
}

model ReferralCommission {
  id         String   @id @default(cuid())
  referrerId String
  referredId String
  depositId  String
  amount     Int
  rate       Float
  createdAt  DateTime @default(now())

  referrer User @relation("CommissionReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("CommissionReferred", fields: [referredId], references: [id], onDelete: Cascade)

  @@unique([depositId])
  @@index([referrerId, createdAt])
}

model Tournament {
  id              String    @id @default(cuid())
  name            String
  description     String?   @db.Text
  status          String    @default("SCHEDULED") // SCHEDULED | RUNNING | FINISHED | CANCELLED
  entryFee        Int       @default(0) // cents, 0 = free entry
  prizePool       Int       @default(0) // cents, grows with entry fees
  startingBalance Int       @default(100000) // tournament chips handed to each entrant
  maxEntries      Int       @default(0) // 0 = unlimited
  // percentage split for the leaderboard, highest place first: "50,30,20"
  prizeSplit      String    @default("50,30,20")
  startsAt        DateTime
  endsAt          DateTime
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())

  entries TournamentEntry[]

  @@index([status, startsAt])
}

model TournamentEntry {
  id              String   @id @default(cuid())
  tournamentId    String
  userId          String
  balance         Int // current tournament chips
  startingBalance Int
  trades          Int      @default(0)
  wins            Int      @default(0)
  rank            Int?
  prize           Int      @default(0)
  joinedAt        DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([tournamentId, balance])
}

model SupportTicket {
  id            String   @id @default(cuid())
  userId        String
  subject       String
  status        String   @default("OPEN") // OPEN | ANSWERED | CLOSED
  unreadByUser  Int      @default(0)
  unreadByAgent Int      @default(0)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([status, lastMessageAt])
  @@index([userId])
}

model SupportMessage {
  id          String   @id @default(cuid())
  ticketId    String
  senderId    String
  fromSupport Boolean  @default(false)
  body        String   @db.Text
  createdAt   DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

/// A reusable set of weekly opening hours, shared by every market that trades
/// on the same exchange calendar (forex, US equities, metals…).
model TradingSchedule {
  id        String   @id @default(cuid())
  key       String   @unique // forex-24-5, us-equities
  name      String
  note      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  windows  ScheduleWindow[]
  holidays MarketHoliday[]
  assets   Asset[]
}

/// One opening window. Times are minutes from midnight UTC on `dayOfWeek`
/// (0 = Sunday); `closeMinute` may exceed 1440 to run into the next day.
model ScheduleWindow {
  id          String @id @default(cuid())
  scheduleId  String
  dayOfWeek   Int // 0-6, Sunday first
  openMinute  Int // 0-1439
  closeMinute Int // 1-2880

  schedule TradingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, dayOfWeek])
}

/// A full-day closure (UTC date) for every market on the schedule.
model MarketHoliday {
  id         String   @id @default(cuid())
  scheduleId String
  date       String // YYYY-MM-DD in UTC
  name       String
  createdAt  DateTime @default(now())

  schedule TradingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, date])
  @@index([date])
}

/// An order that becomes a position when a condition is met.
///
/// Two conditions: the price reaching a level, or a set time arriving. The
/// server executes them from the feed, claiming the row before it places
/// anything so a restart or two overlapping passes can never open the same
/// order twice.
///
/// No money is held while an order waits — it is not a position yet. Whatever
/// would refuse the trade at the moment of purchase (balance, a risk limit, a
/// closed market) refuses it at the moment of triggering, and the reason is
/// recorded on the order.
model PendingTrade {
  id           String  @id @default(cuid())
  userId       String
  assetId      String
  symbol       String
  accountType  String // DEMO | REAL | TOURNAMENT
  entryId      String?
  tournamentId String?
  direction    String // UP | DOWN
  stake        Int

  /// PRICE | TIME
  trigger      String
  /// PRICE: the level to reach, and which way the price must cross it.
  triggerPrice Float?
  /// ABOVE | BELOW, resolved from the price when the order was placed.
  triggerSide  String?
  /// TIME: when to open.
  triggerAt    DateTime?

  /// The expiry the resulting position will carry.
  expiryMode  String    @default("DURATION")
  durationSec Int?
  expiresAt   DateTime?

  /// PENDING | TRIGGERED | CANCELLED | EXPIRED | FAILED
  status    String   @default("PENDING")
  /// When the order gives up, so an unreached level does not wait forever.
  goodUntil DateTime

  /// The position it became, once it has.
  tradeId       String?   @unique
  failureReason String?
  triggeredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id])

  @@index([userId, status])
  /// the execution sweep reads by status, then by symbol or by time
  @@index([status, symbol])
  @@index([status, triggerAt])
}

/// A configurable adjustment to a market's payout.
///
/// Rules never look at a trader, a position or the house's exposure — only at
/// the clock, the calendar and how much the market is moving. What they resolve
/// to is locked into the trade row the moment it opens.
model PayoutRule {
  id   String @id @default(cuid())
  name String

  /// TIME_OF_DAY | VOLATILITY | SCHEDULE
  kind String

  /// Scope: a single market, a whole class, or (both null) every market.
  assetId    String?
  assetClass String?
  asset      Asset?  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// Percentage points added to the base payout; negative lowers it.
  adjustment Int

  /// Kind-specific configuration, validated per kind by zod.
  config Json

  /// Lower numbers resolve first; a rule may stop the ones after it.
  priority  Int      @default(0)
  exclusive Boolean  @default(false)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, priority])
  @@index([assetId, enabled])
}

/// The price engine's whole state per market, so a restart continues the same
/// path instead of re-seeding and printing a gap.
model OtcMarketState {
  symbol          String   @id
  price           Float
  anchor          Float
  variance        Float
  lastShock       Float    @default(0)
  regime          String   @default("RANGE")
  /// the regime's full length, which sizes its trend, and what is left of it
  regimeTicks     Int      @default(0)
  regimeTicksLeft Int      @default(0)
  trendDirection  Int      @default(1)
  /// mulberry32 state is a uint32, which does not fit a signed INT
  rng             Int      @db.UnsignedInt
  ticks           Int      @default(0)
  updatedAt       DateTime @updatedAt
}

/// Rolling OHLC history per market and timeframe.
///
/// The composite id makes a write idempotent: re-flushing the same bucket
/// updates it instead of duplicating. Retention is enforced per timeframe by
/// the candle store, so short timeframes stay small.
model Candle {
  symbol    String
  timeframe String
  /// bucket start, unix seconds
  time      Int
  open      Float
  high      Float
  low       Float
  close     Float

  @@id([symbol, timeframe, time])
  @@index([symbol, timeframe, time(sort: Desc)])
  @@index([timeframe, time])
}
