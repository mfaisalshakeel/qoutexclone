# Used by docker compose. Copy to .env and edit before going live.
APP_PORT=4000

MYSQL_DATABASE=quotex
MYSQL_USER=quotex
MYSQL_PASSWORD=change-this-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_PORT=3306

# openssl rand -hex 32
JWT_SECRET=change-this-secret
JWT_REFRESH_SECRET=change-this-other-secret

# Comma separated origins, or * when the API also serves the web client
CORS_ORIGINS=*

# simulated = built-in price engine, binance = live stream (falls back automatically)
FEED_PROVIDER=simulated

# MUST be false in production: true auto-credits pending deposits for demos
MOCK_CHAIN_WATCHER=true
AUTO_APPROVE_WITHDRAWALS=false

ADMIN_EMAIL=admin@quotexclone.dev
ADMIN_PASSWORD=Admin123!
